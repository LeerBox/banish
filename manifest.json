{
  "manifest_version": 3,
  "name": "Banish – Quick block for TikTok",
  "version": "1.2.2",
  "description": "One-click 'Not interested' + Block for TikTok accounts — on videos, comments, profiles and search. Created by LeerBox.",
  "homepage_url": "https://github.com/LeerBox/banish",
  "permissions": ["storage"],
  "host_permissions": ["https://www.tiktok.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Banish",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
